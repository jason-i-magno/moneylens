# Bank Sync (Plaid). Copy this file to .env.local (gitignored) and fill in the keys from
# https://dashboard.plaid.com/developers/keys, then restart `npm run dev`.
# Never add a VITE_ prefix: Vite would copy the value into the page.

# One client ID for both environments
PLAID_CLIENT_ID=

# Each environment has its own secret
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# Which one to use: sandbox (fake banks, user_good / pass_good) or production (your real banks).
PLAID_ENV=sandbox

# Optional: where bank access tokens are stored. Default: ~/.config/moneylens/plaid-tokens.json
# PLAID_TOKEN_FILE=

# Optional: where the app's data is stored once it's moved to the server (Settings → Storage).
# Default: ~/.config/moneylens/moneylens.db
# MONEYLENS_DB=

# Optional: Claude reads HSA receipts (the HSA page) and writes the monthly review's summary (the Review page).
# An API key from https://platform.claude.com; an `ant auth login` profile works too. Without it, receipt
# details are entered by hand and the review has no written summary.
# ANTHROPIC_API_KEY=

# Optional: a phone notification when a month's review is ready (the 2nd of the next month, 9 AM), through
# ntfy (https://ntfy.sh): install its app and subscribe to a topic. On the shared ntfy.sh server anyone who
# knows the topic can read it, so make it long and random. The notification has no amounts or merchants.
# MONEYLENS_NTFY_TOPIC=
# MONEYLENS_NTFY_SERVER=https://ntfy.sh
# MONEYLENS_NTFY_TOKEN=
# The address the notification opens, e.g. the `tailscale serve` one: https://your-machine.your-tailnet.ts.net:8443
# MONEYLENS_APP_URL=

# Optional: names besides localhost the app is opened at, comma-separated, e.g. the address
# `tailscale serve` gives this computer (your-machine.your-tailnet.ts.net). Vite and the local APIs
# refuse requests to any other name.
# MONEYLENS_ALLOWED_HOSTS=
