# Bank Sync (Plaid). Copy this file to .env.local (gitignored) and fill in the keys from
# https://dashboard.plaid.com/developers/keys, then restart `npm run dev`.
# Never add a VITE_ prefix: Vite would copy the value into the page.

# One client ID for both environments
PLAID_CLIENT_ID=

# Each environment has its own secret
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# Which one to use: sandbox (fake banks, user_good / pass_good) or production (your real banks).
PLAID_ENV=sandbox

# Optional: where bank access tokens are stored. Default: ~/.config/moneylens/plaid-tokens.json
# PLAID_TOKEN_FILE=
